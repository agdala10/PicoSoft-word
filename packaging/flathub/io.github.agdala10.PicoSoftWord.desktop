[Desktop Entry]
Type=Application
Name=PicoSoft - Word 2026
GenericName=Procesador de textos
Comment=El Microsoft Office 2026 Libre 100% Gratuito
Exec=picosoft-word %f
Icon=io.github.agdala10.PicoSoftWord
Terminal=false
Categories=Office;WordProcessor;TextEditor;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;text/markdown;text/html;application/rtf;
Keywords=word;documento;texto;office;picosoft;
StartupWMClass=picosoft-word
